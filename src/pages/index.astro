---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatsCard from '../components/StatsCard.astro';
import HabitCard from '../components/HabitCard.astro';
import HabitForm from '../components/HabitForm.astro';

const initialHabits = [
  { id: 1, name: 'Leer 30 minutos', icon: '📚', color: 'bg-blue-100 dark:bg-blue-900', completed: false, streak: 5 },
  { id: 2, name: 'Hacer ejercicio', icon: '💪', color: 'bg-green-100 dark:bg-green-900', completed: true, streak: 12 },
  { id: 3, name: 'Beber 2L de agua', icon: '💧', color: 'bg-purple-100 dark:bg-purple-900', completed: false, streak: 8 },
  { id: 4, name: 'Meditar', icon: '🧘', color: 'bg-orange-100 dark:bg-orange-900', completed: true, streak: 21 },
  { id: 5, name: 'Correr 5km', icon: '🏃', color: 'bg-pink-100 dark:bg-pink-900', completed: false, streak: 3 },
  { id: 6, name: 'Dormir 8 horas', icon: '😴', color: 'bg-yellow-100 dark:bg-yellow-900', completed: true, streak: 15 },
];
---

<BaseLayout title="Habit Dashboard">
  <Header darkMode={false} />

  <main class="container mx-auto px-4 py-8">
    <!-- Sección Inicio -->
    <section id="inicio" class="mb-12">
      <div class="text-center mb-8">
        <h2 class="text-4xl font-bold text-gray-800 dark:text-white mb-2">
          Bienvenido a tu Dashboard de Hábitos
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-lg">
          Seguimiento diario de tus hábitos para construir mejores rutinas
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatsCard title="Total Hábitos" value="6" icon="📋" color="bg-blue-100 dark:bg-blue-900" change="+2 esta semana" />
        <StatsCard title="Completados Hoy" value="3" icon="✓" color="bg-green-100 dark:bg-green-900" change="50% completado" />
        <StatsCard title="Racha Máxima" value="21" icon="🔥" color="bg-orange-100 dark:bg-orange-900" />
        <StatsCard title="Puntaje" value="85%" icon="⭐" color="bg-purple-100 dark:bg-purple-900" change="+5% vs ayer" />
      </div>
    </section>

    <!-- Sección Hábitos -->
    <section id="habitos" class="mb-12">
      <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-6">Mis Hábitos</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {initialHabits.map(habit => (
          <HabitCard habit={habit} />
        ))}
      </div>
    </section>

    <!-- Sección Agregar -->
    <section class="mb-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <HabitForm />

        <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl shadow-lg p-6 text-white">
          <h2 class="text-xl font-bold mb-4">💡 Consejo del Día</h2>
          <p class="text-lg mb-4">
            "La consistencia es más importante que la intensidad. Es mejor hacer 5 minutos diarios
            que una hora una vez a la semana."
          </p>
          <div class="mt-6 p-4 bg-white/20 rounded-lg backdrop-blur-sm">
            <p class="text-sm font-medium">Progreso Semanal</p>
            <div class="w-full bg-white/30 rounded-full h-4 mt-2">
              <div class="bg-white h-4 rounded-full transition-all duration-500" style="width: 65%"></div>
            </div>
            <p class="text-sm mt-2">65% completado (13/20 hábitos)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección Estadísticas -->
    <section id="estadisticas" class="mb-12">
      <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-6">Estadísticas Detalladas</h2>
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Rendimiento por Hábito</h3>
            <div class="space-y-3">
              {initialHabits.map(habit => (
                <div class="flex items-center gap-3">
                  <span class="text-xl">{habit.icon}</span>
                  <div class="flex-1">
                    <div class="flex justify-between mb-1">
                      <span class="text-sm text-gray-600 dark:text-gray-400">{habit.name}</span>
                      <span class="text-sm font-medium text-gray-800 dark:text-white">{habit.streak} días</span>
                    </div>
                    <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                      <div
                        class="h-2 rounded-full transition-all duration-500"
                        style={`width: ${Math.min(habit.streak * 5, 100)}%; background: ${habit.completed ? '#22c55e' : '#3b82f6'}`}
                      ></div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Actividad Semanal</h3>
            <div class="flex justify-between items-end h-40">
              {['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'].map((day, i) => {
                const heights = [60, 80, 45, 90, 70, 50, 65];
                return (
                  <div class="flex flex-col items-center gap-2">
                    <div
                      class={`w-8 rounded-lg transition-all duration-300 ${
                        i === 3 ? 'bg-blue-500' : 'bg-gray-300 dark:bg-gray-600'
                      }`}
                      style={`height: ${heights[i]}%`}
                    ></div>
                    <span class="text-xs text-gray-600 dark:text-gray-400">{day}</span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-12">
    <div class="container mx-auto px-4 py-6 text-center text-gray-600 dark:text-gray-400">
      <p>© 2026 Habit Dashboard - Actividad Diagnóstico Frontend</p>
      <p class="text-sm mt-2">Desarrollado con Astro + Tailwind CSS</p>
    </div>
  </footer>

  <script src="../scripts/main.js" client:load></script>
  <script>
    // Dark mode toggle básico (se complementa con main.js)
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;

    if (localStorage.getItem('darkMode') === 'true') {
      html.classList.add('dark');
      themeToggle.textContent = '☀️';
    }

    // Fetch de API externa - Clima
    async function fetchWeather() {
      try {
        const response = await fetch('https://api.open-meteo.com/v1/forecast?latitude=-34.6037&longitude=-58.3816&current_weather=true');
        const data = await response.json();
        console.log('Clima en Buenos Aires:', data.current_weather);
      } catch (error) {
        console.error('Error fetching weather:', error);
      }
    }
    fetchWeather();
  </script>
</BaseLayout>
