---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Generador de Contraseñas Seguras">
  <div class="min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900 py-12 px-4">
    <div class="max-w-2xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-2">
          🔐 Generador de Contraseñas
        </h1>
        <p class="text-gray-400 text-lg">Crea contraseñas seguras o analiza las tuyas</p>
      </div>

      <!-- Password Input/Display -->
      <div class="bg-gray-800 rounded-2xl p-6 mb-6 shadow-2xl border border-gray-700">
        <label class="block text-gray-300 font-medium mb-2">
          Ingresa o genera una contraseña
        </label>
        <div class="relative">
          <input
            type="text"
            id="password-display"
            class="w-full bg-gray-900 text-white text-2xl md:text-3xl font-mono py-4 px-4 pr-32 rounded-xl border border-gray-600 focus:outline-none focus:border-purple-500 tracking-wider"
            placeholder="Escribe o genera tu contraseña"
            autocomplete="off"
          />
          <div class="absolute right-2 top-1/2 -translate-y-1/2 flex gap-2">
            <button
              id="copy-btn"
              class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg transition-all hover:scale-105 active:scale-95"
              title="Copiar"
            >
              📋
            </button>
            <button
              id="generate-btn"
              class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-all hover:scale-105 active:scale-95"
              title="Generar nueva"
            >
              🔄
            </button>
          </div>
        </div>

        <!-- Strength Meter -->
        <div class="mt-4">
          <div class="flex justify-between items-center mb-2">
            <span class="text-gray-400 text-sm">Fortaleza:</span>
            <span id="strength-text" class="font-semibold text-lg"></span>
          </div>
          <div class="w-full bg-gray-700 rounded-full h-3 overflow-hidden">
            <div
              id="strength-bar"
              class="h-full rounded-full transition-all duration-500 ease-out"
              style="width: 0%"
            ></div>
          </div>
          <div id="strength-details" class="mt-3 text-sm text-gray-400"></div>
        </div>
      </div>

      <!-- Options -->
      <div class="bg-gray-800 rounded-2xl p-6 shadow-2xl border border-gray-700 mb-6">
        <h2 class="text-xl font-bold text-white mb-4">⚙️ Opciones de generación</h2>

        <!-- Length Slider -->
        <div class="mb-6">
          <div class="flex justify-between items-center mb-2">
            <label class="text-gray-300 font-medium">Longitud</label>
            <span id="length-value" class="text-purple-400 font-bold text-xl">16</span>
          </div>
          <input
            type="range"
            id="length-slider"
            min="4"
            max="50"
            value="16"
            class="w-full h-3 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-purple-500"
          />
          <div class="flex justify-between text-xs text-gray-500 mt-1">
            <span>4</span>
            <span>50</span>
          </div>
        </div>

        <!-- Checkboxes -->
        <div class="grid grid-cols-2 gap-4">
          <label class="flex items-center gap-3 cursor-pointer group">
            <input
              type="checkbox"
              id="uppercase"
              checked
              class="w-5 h-5 rounded bg-gray-700 border-gray-600 text-purple-600 focus:ring-purple-500 focus:ring-2"
            />
            <span class="text-gray-300 group-hover:text-white transition-colors">Mayúsculas (A-Z)</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer group">
            <input
              type="checkbox"
              id="lowercase"
              checked
              class="w-5 h-5 rounded bg-gray-700 border-gray-600 text-purple-600 focus:ring-purple-500 focus:ring-2"
            />
            <span class="text-gray-300 group-hover:text-white transition-colors">Minúsculas (a-z)</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer group">
            <input
              type="checkbox"
              id="numbers"
              checked
              class="w-5 h-5 rounded bg-gray-700 border-gray-600 text-purple-600 focus:ring-purple-500 focus:ring-2"
            />
            <span class="text-gray-300 group-hover:text-white transition-colors">Números (0-9)</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer group">
            <input
              type="checkbox"
              id="symbols"
              checked
              class="w-5 h-5 rounded bg-gray-700 border-gray-600 text-purple-600 focus:ring-purple-500 focus:ring-2"
            />
            <span class="text-gray-300 group-hover:text-white transition-colors">Símbolos (!@#)</span>
          </label>
        </div>

        <!-- Exclude Ambiguous -->
        <label class="flex items-center gap-3 cursor-pointer group mt-4">
          <input
            type="checkbox"
            id="exclude-ambiguous"
            class="w-5 h-5 rounded bg-gray-700 border-gray-600 text-purple-600 focus:ring-purple-500 focus:ring-2"
          />
          <span class="text-gray-300 group-hover:text-white transition-colors">Excluir caracteres confundibles (I, l, 1, O, 0)</span>
        </label>
      </div>

      <!-- Security Info -->
      <div class="bg-gray-800 rounded-2xl p-6 shadow-2xl border border-gray-700">
        <h2 class="text-xl font-bold text-white mb-4">🛡️ Consejos de Seguridad</h2>
        <ul class="space-y-2 text-gray-400">
          <li class="flex items-start gap-2">
            <span class="text-green-400">✓</span>
            Usa al menos 12 caracteres
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-400">✓</span>
            Combina mayúsculas, minúsculas, números y símbolos
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-400">✓</span>
            No uses información personal
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-400">✓</span>
            Usa una contraseña única por cuenta
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-400">✓</span>
             Usa un gestor de contraseñas
          </li>
        </ul>
      </div>
    </div>
  </div>

  <script>
    // Caracteres disponibles
    const CHAR_SETS = {
      uppercase: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
      lowercase: 'abcdefghijklmnopqrstuvwxyz',
      numbers: '0123456789',
      symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?'
    };

    const AMBIGUOUS = 'Il1O0';

    // Generar contraseña
    function generatePassword() {
      const length = parseInt(document.getElementById('length-slider').value);
      const useUppercase = document.getElementById('uppercase').checked;
      const useLowercase = document.getElementById('lowercase').checked;
      const useNumbers = document.getElementById('numbers').checked;
      const useSymbols = document.getElementById('symbols').checked;
      const excludeAmbiguous = document.getElementById('exclude-ambiguous').checked;

      let chars = '';
      if (useUppercase) chars += CHAR_SETS.uppercase;
      if (useLowercase) chars += CHAR_SETS.lowercase;
      if (useNumbers) chars += CHAR_SETS.numbers;
      if (useSymbols) chars += CHAR_SETS.symbols;

      if (excludeAmbiguous) {
        for (const char of AMBIGUOUS) {
          chars = chars.replace(new RegExp(char, 'g'), '');
        }
      }

      if (chars === '') {
        return '';
      }

      // Al menos un carácter de cada tipo seleccionado
      let password = '';
      const required = [];

      if (useUppercase) required.push(CHAR_SETS.uppercase);
      if (useLowercase) required.push(CHAR_SETS.lowercase);
      if (useNumbers) required.push(CHAR_SETS.numbers);
      if (useSymbols) required.push(CHAR_SETS.symbols);

      for (const set of required) {
        password += set[Math.floor(Math.random() * set.length)];
      }

      // Rellenar el resto
      for (let i = password.length; i < length; i++) {
        password += chars[Math.floor(Math.random() * chars.length)];
      }

      // Mezclar
      return password.split('').sort(() => Math.random() - 0.5).join('');
    }

    // Calcular fortaleza
    function calculateStrength(password) {
      if (!password) return { score: 0, details: [] };

      let score = 0;
      const details = [];

      // Longitud
      if (password.length >= 8) {
        score += 20;
        details.push('✓ Longitud adecuada');
      }
      if (password.length >= 12) {
        score += 15;
        details.push('✓ Buena longitud');
      }
      if (password.length >= 16) {
        score += 15;
        details.push('✓ Excelente longitud');
      }

      // Mayúsculas
      if (/[A-Z]/.test(password)) {
        score += 15;
        details.push('✓ Incluye mayúsculas');
      }

      // Minúsculas
      if (/[a-z]/.test(password)) {
        score += 15;
        details.push('✓ Incluye minúsculas');
      }

      // Números
      if (/[0-9]/.test(password)) {
        score += 10;
        details.push('✓ Incluye números');
      }

      // Símbolos
      if (/[!@#$%^&*()_+\-=\[\]{}|;:,.<>?]/.test(password)) {
        score += 15;
        details.push('✓ Incluye símbolos');
      }

      // Patrones comunes (restar puntos)
      if (/^[a-zA-Z]+$/.test(password)) {
        score -= 20;
        details.push('✗ Solo letras (débil)');
      }
      if (/^[0-9]+$/.test(password)) {
        score -= 20;
        details.push('✗ Solo números (débil)');
      }
      if (/(.)\1{2,}/.test(password)) {
        score -= 10;
        details.push('✗ Caracteres repetidos');
      }
      if (/^(123|abc|qwerty|password)/i.test(password)) {
        score -= 30;
        details.push('✗ Patrón común detectado');
      }

      // Normalizar
      score = Math.max(0, Math.min(100, score));

      return { score, details };
    }

    // Obtener texto de fortaleza
    function getStrengthText(score) {
      if (score === 0) return { text: '', color: '' };
      if (score < 30) return { text: '🔴 Muy Débil', color: 'text-red-500' };
      if (score < 50) return { text: '🟠 Débil', color: 'text-orange-500' };
      if (score < 70) return { text: '🟡 Regular', color: 'text-yellow-500' };
      if (score < 90) return { text: '🟢 Buena', color: 'text-green-500' };
      return { text: '🟢🟢 Excelente', color: 'text-emerald-400' };
    }

    // Obtener color de la barra
    function getStrengthColor(score) {
      if (score < 30) return 'bg-red-500';
      if (score < 50) return 'bg-orange-500';
      if (score < 70) return 'bg-yellow-500';
      if (score < 90) return 'bg-green-500';
      return 'bg-emerald-400';
    }

    // Actualizar UI
    function updateUI(password) {
      const display = document.getElementById('password-display');
      const strengthBar = document.getElementById('strength-bar');
      const strengthText = document.getElementById('strength-text');
      const strengthDetails = document.getElementById('strength-details');

      display.value = password;

      const { score, details } = calculateStrength(password);
      const { text, color } = getStrengthText(score);

      strengthBar.style.width = `${score}%`;
      strengthBar.className = `h-full rounded-full transition-all duration-500 ease-out ${getStrengthColor(score)}`;
      strengthText.textContent = text;
      strengthText.className = `font-semibold text-lg ${color}`;
      strengthDetails.innerHTML = details.map(d => `<span class="${d.startsWith('✗') ? 'text-red-400' : 'text-green-400'}">${d}</span>`).join('<br>');
    }

    // Copiar al portapapeles
    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        const btn = document.getElementById('copy-btn');
        const original = btn.textContent;
        btn.textContent = '✓';
        btn.classList.add('bg-green-600');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('bg-green-600');
        }, 1500);
      } catch (err) {
        // Fallback
        const display = document.getElementById('password-display');
        display.select();
        document.execCommand('copy');
      }
    }

    // Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      const generateBtn = document.getElementById('generate-btn');
      const copyBtn = document.getElementById('copy-btn');
      const lengthSlider = document.getElementById('length-slider');
      const lengthValue = document.getElementById('length-value');
      const checkboxes = document.querySelectorAll('input[type="checkbox"]');
      const passwordDisplay = document.getElementById('password-display');

      // Generar contraseña inicial
      const initialPassword = generatePassword();
      updateUI(initialPassword);

      // Botón generar
      generateBtn.addEventListener('click', () => {
        const password = generatePassword();
        updateUI(password);
      });

      // Botón copiar
      copyBtn.addEventListener('click', () => {
        const password = passwordDisplay.value;
        if (password) copyToClipboard(password);
      });

      // Slider de longitud
      lengthSlider.addEventListener('input', () => {
        lengthValue.textContent = lengthSlider.value;
        const password = generatePassword();
        updateUI(password);
      });

      // Checkboxes
      checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
          const password = generatePassword();
          updateUI(password);
        });
      });

      // Input manual - analizar en tiempo real
      passwordDisplay.addEventListener('input', () => {
        const password = passwordDisplay.value;
        if (password) {
          const { score, details } = calculateStrength(password);
          const { text, color } = getStrengthText(score);

          document.getElementById('strength-bar').style.width = `${score}%`;
          document.getElementById('strength-bar').className = `h-full rounded-full transition-all duration-500 ease-out ${getStrengthColor(score)}`;
          document.getElementById('strength-text').textContent = text;
          document.getElementById('strength-text').className = `font-semibold text-lg ${color}`;
          document.getElementById('strength-details').innerHTML = details.map(d => `<span class="${d.startsWith('✗') ? 'text-red-400' : 'text-green-400'}">${d}</span>`).join('<br>');
        }
      });

      // Click en el display para copiar
      passwordDisplay.addEventListener('click', () => {
        const password = passwordDisplay.value;
        if (password) copyToClipboard(password);
      });
    });
  </script>
</BaseLayout>
