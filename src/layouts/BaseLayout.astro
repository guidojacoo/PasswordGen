---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Dashboard de hábitos - Seguimiento de hábitos diarios" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
    <style>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
    </style>
    <slot />
  </body>
</html>
