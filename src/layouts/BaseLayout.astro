---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Generador de contraseñas seguras con análisis de fortaleza" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-gray-900">
    <slot />
  </body>
</html>
