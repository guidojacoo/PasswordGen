---
interface Props {
  title: string;
  value: string | number;
  icon: string;
  color: string;
  change?: string;
}

const { title, value, icon, color, change } = Astro.props;
---

<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm text-gray-500 dark:text-gray-400">{title}</p>
      <p class="text-3xl font-bold text-gray-800 dark:text-white mt-1">{value}</p>
      {change && (
        <p class="text-sm text-green-500 mt-1">{change}</p>
      )}
    </div>
    <div class={`w-16 h-16 rounded-full flex items-center justify-center text-3xl ${color}`}>
      {icon}
    </div>
  </div>
</div>
