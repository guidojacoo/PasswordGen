---
interface Props {
  darkMode: boolean;
}

const { darkMode } = Astro.props;
---

<header class="bg-white dark:bg-gray-800 shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <span class="text-3xl">🎯</span>
      <h1 class="text-xl font-bold text-gray-800 dark:text-white">Habit Dashboard</h1>
    </div>
    <nav class="flex items-center gap-4">
      <a href="#inicio" class="text-gray-600 dark:text-gray-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors">Inicio</a>
      <a href="#habitos" class="text-gray-600 dark:text-gray-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors">Hábitos</a>
      <a href="#estadisticas" class="text-gray-600 dark:text-gray-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors">Estadísticas</a>
      <button
        id="theme-toggle"
        class="p-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
        data-dark-mode={darkMode}
      >
        {darkMode ? '☀️' : '🌙'}
      </button>
    </nav>
  </div>
</header>
